{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Dinoco",
	"scopeName": "source.dinoco",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#import_statement" },
		{ "include": "#strings" },
		{ "include": "#model_declaration" },
		{ "include": "#config_declaration" },
		{ "include": "#workspace_entry_declaration" },
		{ "include": "#enum_declaration" },
		{ "include": "#primitive_fields" },
		{ "include": "#custom_fields" },
		{ "include": "#model_decorators" },
		{ "include": "#core_attributes" },
		{ "include": "#decorators" },
		{ "include": "#named_parameters" },
		{ "include": "#functions" },
		{ "include": "#constants" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"match": "#.*$",
					"name": "comment.line.number-sign.dinoco"
				},
				{
					"match": "//.*$",
					"name": "comment.line.double-slash.dinoco"
				}
			]
		},
		"strings": {
			"begin": "\"",
			"end": "\"",
			"name": "string.quoted.double.dinoco"
		},
		"import_statement": {
			"name": "meta.import.dinoco",
			"begin": "^\\s*(import)\\b",
			"beginCaptures": {
				"1": { "name": "keyword.control.import.dinoco" }
			},
			"end": "(?<=\")",
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#strings" },
				{
					"match": "\\b(from)\\b",
					"captures": {
						"1": { "name": "keyword.control.import.dinoco" }
					}
				},
				{
					"match": "[{}]",
					"name": "punctuation.section.braces.dinoco"
				},
				{
					"match": ",",
					"name": "punctuation.separator.comma.dinoco"
				},
				{
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
					"name": "entity.name.type.import.dinoco"
				}
			]
		},
		"model_declaration": {
			"match": "^\\s*(model)(\\s+([A-Za-z][a-zA-Z0-9_]*))?",
			"captures": {
				"1": { "name": "keyword.control.model.dinoco" },
				"2": { "name": "entity.name.type.class.dinoco" }
			}
		},
		"enum_declaration": {
			"match": "^\\s*(enum)(\\s+([A-Za-z][a-zA-Z_]*))?",
			"captures": {
				"1": { "name": "keyword.control.enum.dinoco" },
				"2": { "name": "entity.name.type.class.dinoco" }
			}
		},
		"config_declaration": {
			"match": "^\\s*(config|workspace)\\b",
			"name": "keyword.control.config.dinoco"
		},
		"workspace_entry_declaration": {
			"comment": "Named sub-blocks inside a workspace { ... } block, e.g. dev { ... } / prod { ... }.",
			"match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\{)",
			"captures": {
				"1": { "name": "entity.name.namespace.dinoco" }
			}
		},
		"primitive_fields": {
			"match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s+(String|Integer|Boolean|Json|Float|Date|DateTime)\\b(\\[\\]|\\?)?",
			"captures": {
				"1": { "name": "variable.other.property.dinoco" },
				"2": { "name": "support.type.primitive.dinoco" },
				"3": { "name": "keyword.operator.modifier.dinoco" }
			}
		},
		"custom_fields": {
			"match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s+([A-Za-z][a-zA-Z0-9_]*)\\b(\\[\\]|\\?)?",
			"captures": {
				"1": { "name": "variable.other.property.dinoco" },
				"2": { "name": "entity.name.type.dinoco" },
				"3": { "name": "keyword.operator.modifier.dinoco" }
			}
		},
		"model_decorators": {
			"patterns": [
				{
					"begin": "(@@)(ids|uniques|indexes|fulltexts)(\\s*\\()",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.decorator.dinoco" },
						"2": { "name": "entity.name.function.decorator.dinoco" },
						"3": { "name": "punctuation.section.group.begin.dinoco" }
					},
					"end": "(\\))",
					"endCaptures": {
						"1": { "name": "punctuation.section.group.end.dinoco" }
					},
					"patterns": [
						{
							"match": "(\\[|\\]|,)",
							"name": "punctuation.separator.array.dinoco"
						},
						{
							"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
							"name": "constant.language.dinoco"
						}
					]
				},
				{
					"begin": "(@@)(table_name)(\\s*\\()",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.decorator.dinoco" },
						"2": { "name": "entity.name.function.decorator.dinoco" },
						"3": { "name": "punctuation.section.group.begin.dinoco" }
					},
					"end": "(\\))",
					"endCaptures": {
						"1": { "name": "punctuation.section.group.end.dinoco" }
					},
					"patterns": [
						{ "include": "#strings" }
					]
				},
				{
					"match": "(@@)([a-zA-Z_][a-zA-Z0-9_]*)",
					"captures": {
						"1": { "name": "punctuation.definition.decorator.dinoco" },
						"2": { "name": "entity.name.function.decorator.dinoco" }
					}
				}
			]
		},
		"core_attributes": {
			"comment": "Field-level attributes that are part of the Dinoco language itself, as opposed to unrecognized/typo\u2019d decorators.",
			"match": "(@)(id|unique|relation|default|index|fulltext)\\b",
			"captures": {
				"1": { "name": "punctuation.definition.decorator.dinoco" },
				"2": { "name": "keyword.other.attribute.dinoco" }
			}
		},
		"decorators": {
			"match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
			"captures": {
				"1": { "name": "punctuation.definition.decorator.dinoco" },
				"2": { "name": "entity.name.function.decorator.dinoco" }
			}
		},
		"named_parameters": {
			"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:)",
			"name": "variable.parameter"
		},
		"functions": {
			"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
			"name": "support.function.dinoco"
		},
		"constants": {
			"patterns": [
				{
					"match": "\\b(Cascade|Restrict|NoAction|SetNull|SetDefault)\\b",
					"name": "constant.language"
				},
				{
					"match": "\\b(true|false)\\b",
					"name": "constant.language.boolean"
				},
				{
					"match": "\\b\\d+(\\.\\d+)?\\b",
					"name": "constant.numeric"
				},
				{
					"match": ":\\s*\\[([a-zA-Z0-9_]+)\\]",
					"captures": {
						"1": {
							"name": "constant.language"
						}
					}
				},
				{
					"match": "\\((\\w+)\\)",
					"captures": {
						"1": {
							"name": "constant.language"
						}
					}
				}
			]
		}
	}
}
