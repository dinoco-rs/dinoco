{
	"name": "dinoco-vscode",
	"displayName": "Dinoco",
	"version": "1.1.0",
	"description": "Intelligent language support and database workflows for Dinoco schemas.",
	"publisher": "dinoco-rs",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/dinoco-rs/dinoco.git"
	},
	"homepage": "https://github.com/dinoco-rs/dinoco",
	"bugs": {
		"url": "https://github.com/dinoco-rs/dinoco/issues"
	},
	"icon": "images/icon.png",
	"keywords": [
		"dinoco",
		"orm",
		"database",
		"schema",
		"postgresql",
		"mysql",
		"sqlite",
		"lsp"
	],
	"categories": [
		"Programming Languages",
		"Formatters",
		"Linters",
		"Other"
	],
	"engines": {
		"vscode": "^1.91.0"
	},
	"extensionKind": [
		"workspace"
	],
	"main": "./out/extension.js",
	"activationEvents": [
		"onLanguage:dinoco",
		"onCommand:dinoco.openSchema",
		"onCommand:dinoco.formatSchema",
		"onCommand:dinoco.init",
		"onCommand:dinoco.models.generate",
		"onCommand:dinoco.migrate.generate",
		"onCommand:dinoco.migrate.run"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Dinoco starts a bundled language server and can run database commands."
		},
		"virtualWorkspaces": {
			"supported": false,
			"description": "Dinoco schemas and generated models require a local workspace."
		}
	},
	"scripts": {
		"compile": "tsc -p ./ --noEmit && npm run bundle && npm run build:binaries",
		"bundle": "esbuild ./src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=./out/extension.js --sourcemap",
		"watch": "tsc -watch -p ./",
		"build:binaries": "node ./scripts/build-binaries.mjs",
		"build:binaries:all": "node ./scripts/build-binaries.mjs all",
		"build:binaries:linux": "node ./scripts/build-binaries.mjs linux",
		"build:binaries:macos": "node ./scripts/build-binaries.mjs macos",
		"build:binaries:windows": "node ./scripts/build-binaries.mjs windows"
	},
	"contributes": {
		"languages": [
			{
				"id": "dinoco",
				"aliases": [
					"Dinoco",
					"dinoco"
				],
				"extensions": [
					".dinoco"
				],
				"configuration": "./configs/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "dinoco",
				"scopeName": "source.dinoco",
				"path": "./configs/dinoco.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "dinoco.openSchema",
				"title": "Dinoco: Open Schema",
				"category": "Dinoco"
			},
			{
				"command": "dinoco.formatSchema",
				"title": "Dinoco: Format Schema",
				"category": "Dinoco"
			},
			{
				"command": "dinoco.restartLanguageServer",
				"title": "Dinoco: Restart Language Server",
				"category": "Dinoco"
			},
			{
				"command": "dinoco.showOutput",
				"title": "Dinoco: Show Language Server Output",
				"category": "Dinoco"
			},
			{
				"command": "dinoco.init",
				"title": "Dinoco: Initialize Project",
				"category": "Dinoco"
			},
			{
				"command": "dinoco.models.generate",
				"title": "Dinoco: Generate Models",
				"category": "Dinoco"
			},
			{
				"command": "dinoco.migrate.generate",
				"title": "Dinoco: Generate Migration",
				"category": "Dinoco"
			},
			{
				"command": "dinoco.migrate.run",
				"title": "Dinoco: Run Pending Migrations",
				"category": "Dinoco"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "dinoco.models.generate",
					"when": "editorLangId == dinoco",
					"group": "dinoco@1"
				},
				{
					"command": "dinoco.migrate.generate",
					"when": "editorLangId == dinoco",
					"group": "dinoco@2"
				},
				{
					"command": "dinoco.migrate.run",
					"when": "editorLangId == dinoco",
					"group": "dinoco@3"
				}
			]
		},
		"configuration": {
			"title": "Dinoco",
			"properties": {
				"dinoco.server.path": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"description": "Optional path to a custom Dinoco language server binary. Relative paths resolve from the workspace root."
				},
				"dinoco.cli.path": {
					"type": "string",
					"default": "dinoco",
					"scope": "machine-overridable",
					"description": "Dinoco CLI executable used by migration and model commands."
				},
				"dinoco.models.generateOnSave": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"description": "Generate Rust models after saving a valid Dinoco schema."
				},
				"dinoco.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"scope": "window",
					"description": "Trace communication between VS Code and the Dinoco language server."
				}
			}
		},
		"configurationDefaults": {
			"[dinoco]": {
				"editor.defaultFormatter": "dinoco-rs.dinoco-vscode",
				"editor.formatOnSave": true,
				"editor.semanticHighlighting.enabled": true
			}
		}
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.0"
	},
	"overrides": {
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"@types/vscode": "^1.91.0",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.25.0",
		"typescript": "^5.9.3"
	}
}
