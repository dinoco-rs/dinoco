config {
    database = "postgresql"
    database_url = env("DATABASE_URL")

    read_replicas = [
        env("DATABASE_URL"),
        env("DATABASE_URL")
    ]
}

enum AudioStatus {
    generated
    building
    error
}

enum AudioGender {
    random
    male
    female
}

enum DevicePlataform {
    ios
    android
}

enum DeviceTheme {
    light
    dark
}

model AdminAccount {
    id  String  @id @default(uuid())

    email     String
    password  String

    tokens  AdminToken[]
}

model AdminToken {
    id          String   @id @default(uuid())
    is_expired  Boolean  @default(false)

    created_at  DateTime  @default(now())

    account     AdminAccount?  @relation(fields: [account_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
    account_id  String?
}

enum SubscriptionStatus {
    Active
    Pending
    InGracePeriod
    OnHold
    Paused
    Canceled
    Expired
}

model Account {
    id        String  @id @default(uuid())
    username  String
    avatar    String

    credits  Integer

    devices           Device[]
    subscriptions     Subscription[]
    credit_histories  AccountCreditHistory[]
    audio_creations   AudioCreation[]

    playlists  Playlist[]
}

model AccountCreditHistory {
    id          String  @id @default(uuid())
    product_id  String

    platform  DevicePlataform

    transaction_id  String  @default("")
    purchase_token  String  @default("")

    purchase_at  DateTime  @default(now())

    account_id  String?
    account     Account?  @relation(fields: [account_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Device {
    id            String  @id @default(uuid())
    unique_id     String
    device_model  String

    theme     DeviceTheme
    platform  DevicePlataform

    token  String?

    unlocks  OrixaUnlock[]

    account_id  String?
    account     Account?  @relation(fields: [account_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Subscription {
    id        String              @id @default(uuid())
    status    SubscriptionStatus
    platform  DevicePlataform

    transaction_id  String  @default("")
    purchase_token  String  @default("")

    expire_in  DateTime
    assign_in  DateTime

    account_id  String?
    account     Account?  @relation(fields: [account_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model AudioCreation {
    id  String  @id @default(uuid())

    title   String
    letter  String

    task_id  String

    gender  AudioGender

    status     AudioStatus
    createdAt  DateTime     @default(now())

    image  String?
    error  String?

    variations  AudioVariation[]

    account_id  String?
    account     Account?  @relation(fields: [account_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model AudioVariation {
    id  String  @id @default(uuid())

    audio_url  String
    duration   Float

    creation_id  String?
    creation     AudioCreation?  @relation(fields: [creation_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Study {
    id         String  @id @default(uuid())
    name       String
    image_url  String

    is_show  Boolean
    content  String
}

model Book {
    id  String  @id @default(uuid())

    name         String
    description  String
    image_url    String
    shop_url     String

    read_url  String?
}

model OrixaUnlock {
    id  String  @id @default(uuid())

    created_at  DateTime
    lock_at     DateTime

    orixa     Orixa?   @relation(fields: [orixa_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
    orixa_id  String?

    device     Device?  @relation(fields: [device_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
    device_id  String?
}

model Orixa {
    id       String   @id @default(uuid())
    is_show  Boolean

    name         String
    tag          String
    description  String

    image  String

    unlocks  OrixaUnlock[]

    questions  OrixaQuestion[]
    sections   OrixaSection[]

    falanges  OrixaFalange[]

    total_audios  Integer
}

model OrixaQuestion {
    id  String  @id @default(uuid())

    title    String
    content  String

    audio     String?
    duration  Float?

    is_sumary  Boolean

    orixa_id  String?
    orixa     Orixa?   @relation(fields: [orixa_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model OrixaSection {
    id  String  @id @default(uuid())

    name       String
    icon_type  String

    is_show  Boolean

    contents  OrixaContent[]

    orixa_id  String?
    orixa     Orixa?   @relation(fields: [orixa_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model OrixaFalange {
    id     String  @id @default(uuid())
    name   String
    image  String

    is_show  Boolean

    categories  OrixaFalangeCategory[]

    orixa_id  String?
    orixa     Orixa?   @relation(fields: [orixa_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model OrixaFalangeCategory {
    id  String  @id @default(uuid())

    name       String
    icon_type  String

    is_show  Boolean

    contents  OrixaContent[]

    falange_id  String?
    falange     OrixaFalange?  @relation(fields: [falange_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model OrixaContent {
    id  String  @id @default(uuid())

    is_show  Boolean

    text      String
    audio     String?
    duration  Float?

    tracks  PlaylistTrack[]

    section_id  String?
    section     OrixaSection?  @relation(fields: [section_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

    falange_category_id  String?
    falange_category     OrixaFalangeCategory?  @relation(fields: [falange_category_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model Playlist {
    id  String  @id @default(uuid())

    is_system  Boolean

    name         String
    description  String

    mood  String

    color  String
    cover  String?

    tracks  PlaylistTrack[]

    account_id  String?
    account     Account?  @relation(fields: [account_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}

model PlaylistTrack {
    id  String  @id @default(uuid())

    played_counts  Integer

    name        String
    descripton  String

    image_url  String
    audio_url  String

    duration  Float

    content_id  String?
    content     OrixaContent?  @relation(fields: [content_id], references: [id], onUpdate: Cascade, onDelete: Cascade)

    playlist_id  String?
    playlist     Playlist?  @relation(fields: [playlist_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
}
